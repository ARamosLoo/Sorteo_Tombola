{
  "name": "sorteo-inei",
  "version": "1.0.0",
  "description": "Gran Sorteo Institucional - INEI",
  "author": "Alexander Loo - INEI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "pe.gob.inei.sorteo",
    "productName": "Gran Sorteo INEI",
    "copyright": "Copyright © 2026 Alexander Loo - INEI",
    "directories": { "output": "dist" },
    "files": [
      "index.html",
      "styles.css",
      "main.js",
      "preload.js",
      "js/**/*",
      "assets/**/*",
      "vendor/**/*"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/logo-inei.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gran Sorteo INEI",
      "artifactName": "Instalador-Sorteo-INEI-${version}.exe"
    }
  }
}
